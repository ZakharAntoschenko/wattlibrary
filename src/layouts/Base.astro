---
const {
  title,
  description,
  schema,
  noindex = false,
  ogType = 'website',
  ogImage = '/og-default.png',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
const path = Astro.url.pathname;

const navLinks = [
  { href: '/power-stations/', label: 'Database', match: (p) => p.startsWith('/power-stations/') },
  { href: '/calculator/', label: 'Calculator', match: (p) => p.startsWith('/calculator/') },
  { href: '/compare/', label: 'Compare', match: (p) => p.startsWith('/compare/') },
  { href: '/guides/', label: 'Guides', match: (p) => p.startsWith('/guides/') },
  { href: '/brands/', label: 'Brands', match: (p) => p.startsWith('/brands/') },
  { href: '/about/', label: 'About', match: (p) => p.startsWith('/about/') },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
  <link rel="canonical" href={canonical} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#22201c" />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="WattLibrary" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="WattLibrary — Portable Power Station Specs, Runtimes & MPPT Solar Database" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  <style is:global>
    :root {
      --ink: #22201c; --ink-2: #45413a; --muted: #6c665d; --line: #e3ddd2;
      --accent: #a34a0e; --accent-deep: #82390a; --accent-soft: #f7ecdf; --accent-line: #e4c9a8;
      --ok: #1f6b3a; --ok-soft: #eaf5ee; --ok-line: #b9dec6;
      --warn: #8a5600; --warn-soft: #fdf4e1; --warn-line: #e9cfa0;
      --bad: #9e2a2b; --bad-soft: #fbecec; --bad-line: #e5b8b8;
      --bg: #fcfaf6; --alt: #f4efe6; --paper: #fffdf9;
      --radius: 6px;
      --serif: "Charter", "Bitstream Charter", "Sitka Text", Cambria, Georgia, serif;
    }
    * { box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; }
    body {
      margin: 0; color: var(--ink); background: var(--bg);
      font: 16px/1.65 system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
    }
    a { color: var(--accent-deep); text-decoration-thickness: 1px; text-underline-offset: 2px; }
    a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible, summary:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }
    .skip-link {
      position: absolute; left: -9999px; top: 0;
      background: var(--accent); color: #fff; padding: .5rem 1rem; z-index: 100;
      font-weight: 600; text-decoration: none;
    }
    .skip-link:focus { left: .75rem; top: .5rem; border-radius: var(--radius); }
    .wrap { max-width: 1060px; margin: 0 auto; padding: 0 1.1rem; }

    /* ---------- Header ---------- */
    header.site { background: var(--ink); }
    header.site .wrap { display: flex; align-items: center; flex-wrap: wrap; gap: .6rem 1rem; min-height: 3.35rem; padding-top: .45rem; padding-bottom: .45rem; }
    .logo { display: flex; align-items: center; gap: .5rem; font-family: var(--serif); font-weight: 700; font-size: 1.18rem; color: #f6f1e7; text-decoration: none; }
    .logo svg { flex: none; }
    .logo b { color: #e8a55f; font-weight: 700; }
    nav.main { margin-left: auto; display: flex; flex-wrap: wrap; gap: .4rem 1.05rem; align-items: center; }
    nav.main a { color: #cfc8ba; text-decoration: none; font-size: .92rem; padding: .15rem 0; }
    nav.main a:hover { color: #fff; text-decoration: underline; text-underline-offset: 4px; }
    nav.main a[aria-current="page"] { color: #fff; font-weight: 650; border-bottom: 2px solid #e8a55f; }

    /* ---------- Type ---------- */
    main .wrap { padding-top: 1.9rem; padding-bottom: 3.5rem; }
    h1, h2, h3 { font-family: var(--serif); letter-spacing: 0; }
    h1 { font-size: clamp(1.6rem, 4.2vw, 2.25rem); line-height: 1.15; margin: 0 0 .5rem; text-wrap: balance; font-weight: 700; }
    h2 { font-size: clamp(1.22rem, 2.6vw, 1.45rem); margin: 2.3rem 0 .8rem; font-weight: 700; }
    h3 { font-size: 1.05rem; margin: 1.2rem 0 .25rem; }
    p { margin: .5rem 0 .9rem; }
    .lead { font-size: 1.05rem; color: var(--ink-2); max-width: 680px; }
    .muted { color: var(--muted); }
    .eyebrow { font-size: .78rem; font-weight: 700; text-transform: uppercase; letter-spacing: .09em; color: var(--accent); margin: 0 0 .4rem; }

    /* ---------- Chips & Badges ---------- */
    .pill {
      display: inline-block; background: transparent; color: var(--accent-deep);
      border: 1px solid var(--accent-line); border-radius: 3px;
      padding: .15rem .55rem; font-size: .78rem; font-weight: 600;
    }
    .badge {
      display: inline-block; border-radius: 3px; padding: .12rem .5rem;
      font-size: .78rem; font-weight: 650; line-height: 1.4; white-space: nowrap;
    }
    .badge-ok { background: var(--ok-soft); color: var(--ok); border: 1px solid var(--ok-line); }
    .badge-warn { background: var(--warn-soft); color: var(--warn); border: 1px solid var(--warn-line); }
    .badge-bad { background: var(--bad-soft); color: var(--bad); border: 1px solid var(--bad-line); }

    /* ---------- KPI ---------- */
    .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(132px, 1fr)); gap: .6rem; margin: 1.1rem 0 .4rem; }
    .kpi { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); padding: .65rem .85rem; font-size: .82rem; color: var(--muted); }
    .kpi b { display: block; font-family: var(--serif); font-size: 1.22rem; color: var(--ink); margin-bottom: .05rem; }

    /* ---------- Tables ---------- */
    .tbl { border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; margin: 1rem 0 1.4rem; background: var(--paper); }
    .tbl-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    table { border-collapse: collapse; width: 100%; font-size: .92rem; }
    th, td { text-align: left; padding: .55rem .8rem; border-bottom: 1px solid var(--line); white-space: nowrap; }
    tbody th { white-space: normal; font-weight: 600; color: var(--ink-2); }
    tbody tr:last-child th, tbody tr:last-child td { border-bottom: 0; }
    thead th { background: var(--alt); font-weight: 700; font-size: .76rem; text-transform: uppercase; letter-spacing: .05em; color: var(--ink-2); border-bottom: 2px solid var(--line); }
    td.win { background: var(--accent-soft) !important; font-weight: 650; color: var(--accent-deep); }
    .tbl-sticky th:first-child, .tbl-sticky td:first-child {
      position: sticky; left: 0; z-index: 2; background: var(--paper);
      box-shadow: 1px 0 0 var(--line);
    }
    .tbl-sticky thead th:first-child { background: var(--alt); z-index: 3; }
    th.sortable { cursor: pointer; user-select: none; }
    th.sortable:hover { color: var(--accent-deep); }
    th.sortable::after { content: " ↕"; opacity: .45; font-size: .78em; }
    th.sortable[data-dir="asc"]::after { content: " ↑"; opacity: 1; color: var(--accent); }
    th.sortable[data-dir="desc"]::after { content: " ↓"; opacity: 1; color: var(--accent); }

    /* ---------- Cards & Split Boxes ---------- */
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: .8rem; margin: 1rem 0; }
    .split-2 { display: grid; grid-template-columns: 1fr; gap: .85rem; margin: 1rem 0 1.4rem; }
    @media (min-width: 640px) { .split-2 { grid-template-columns: 1fr 1fr; } }
    .card { border: 1px solid var(--line); border-left: 3px solid var(--accent-line); border-radius: var(--radius); padding: .9rem 1rem; background: var(--paper); }
    .card:hover { border-left-color: var(--accent); }
    .card > a { text-decoration: none; font-weight: 650; color: var(--ink); display: block; }
    .card > a:hover { color: var(--accent-deep); text-decoration: underline; }
    .card .sub { margin: .35rem 0 0; font-size: .86rem; color: var(--muted); }
    .pick-box { border: 1px solid var(--line); border-top: 3px solid var(--accent); border-radius: var(--radius); padding: .95rem 1.05rem; background: var(--paper); }
    .pick-box h3 { margin: 0 0 .35rem; font-size: 1rem; }
    .pick-box p { margin: 0; font-size: .92rem; color: var(--ink-2); }

    /* ---------- Interactive Tools / Forms ---------- */
    .tool-panel {
      background: var(--alt); border: 1px solid var(--line); border-radius: var(--radius);
      padding: 1.05rem 1.15rem; margin: 1rem 0 1.4rem;
    }
    .tool-row { display: flex; flex-wrap: wrap; gap: .7rem 1rem; align-items: flex-end; }
    .field { display: flex; flex-direction: column; gap: .25rem; min-width: 140px; flex: 1 1 160px; }
    .field label { font-size: .8rem; font-weight: 650; color: var(--ink-2); }
    .field input, .field select {
      background: var(--paper); color: var(--ink); border: 1px solid var(--line);
      border-radius: 4px; padding: .45rem .65rem; font: inherit; font-size: .92rem;
    }
    .field input:focus, .field select:focus { border-color: var(--accent); }

    /* ---------- Hero ---------- */
    .hero { background: var(--alt); border-bottom: 1px solid var(--line); }
    .hero .wrap { padding: 2.4rem 1.1rem 2.2rem; }
    .hero h1 { max-width: 680px; }
    .hero .lead { margin-bottom: 1.3rem; }
    .btn {
      display: inline-block; background: var(--accent); color: #fff; text-decoration: none;
      font-weight: 600; font-size: .93rem; padding: .58rem 1.15rem; border-radius: var(--radius);
      border: 1px solid var(--accent); cursor: pointer; font-family: inherit;
    }
    .btn:hover { background: var(--accent-deep); border-color: var(--accent-deep); }
    .btn-ghost { background: var(--paper); color: var(--accent-deep); border: 1px solid var(--accent-line); }
    .btn-ghost:hover { background: var(--accent-soft); }
    .btn-sm { padding: .35rem .75rem; font-size: .84rem; }
    .btn-row { display: flex; flex-wrap: wrap; gap: .6rem; }

    /* ---------- Misc ---------- */
    .crumbs { font-size: .84rem; color: var(--muted); margin-bottom: .9rem; }
    .crumbs a { color: var(--muted); }
    .note { background: var(--accent-soft); border: 1px solid var(--accent-line); border-radius: var(--radius); padding: .75rem 1rem; font-size: .93rem; margin: 1rem 0; }
    .disclosure { background: var(--alt); border: 1px solid var(--line); border-radius: var(--radius); padding: .75rem 1rem; font-size: .83rem; color: var(--muted); margin: 1.6rem 0 0; }
    details.faq { border-bottom: 1px solid var(--line); margin: 0; }
    details.faq summary { cursor: pointer; font-weight: 600; padding: .75rem .2rem; list-style: none; position: relative; padding-right: 2rem; }
    details.faq summary::-webkit-details-marker { display: none; }
    details.faq summary::after { content: "+"; position: absolute; right: .4rem; top: .6rem; font-size: 1.15rem; color: var(--accent); }
    details.faq[open] summary::after { content: "–"; }
    details.faq div { padding: 0 .2rem .85rem; color: var(--ink-2); }

    .filters { display: flex; flex-wrap: wrap; gap: .42rem; margin: .75rem 0; align-items: center; }
    .filters button {
      background: var(--paper); color: var(--ink-2); border: 1px solid var(--line); border-radius: 3px;
      padding: .34rem .78rem; font-size: .85rem; font-weight: 600; cursor: pointer; font-family: inherit;
    }
    .filters button:hover { border-color: var(--accent-line); color: var(--accent-deep); }
    .filters button.active { background: var(--ink); border-color: var(--ink); color: #f6f1e7; }

    /* ---------- Footer ---------- */
    footer.site { border-top: 3px solid var(--ink); background: var(--alt); margin-top: 2rem; }
    footer.site .wrap { padding: 1.9rem 1.1rem 2.3rem; display: grid; gap: 1.4rem; grid-template-columns: 1fr; }
    @media (min-width: 640px) { footer.site .wrap { grid-template-columns: 1.4fr 1fr 1fr; } }
    footer.site p { font-size: .84rem; color: var(--muted); margin: .35rem 0; }
    footer.site .flogo { font-family: var(--serif); font-weight: 700; color: var(--ink); font-size: 1.05rem; }
    footer.site .flogo b { color: var(--accent); }
    footer.site .fhead { font-size: .76rem; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; color: var(--ink-2); margin: 0 0 .45rem; }
    footer.site nav { display: flex; flex-direction: column; gap: .32rem; }
    footer.site nav a { font-size: .87rem; color: var(--ink-2); }

    @media (max-width: 520px) {
      nav.main { gap: .35rem .72rem; }
      nav.main a { font-size: .84rem; }
      th, td { padding: .48rem .58rem; font-size: .86rem; }
    }
  </style>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="site">
    <div class="wrap">
      <a class="logo" href="/" aria-label="WattLibrary home">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="3" y="13.2" width="3" height="6.8" rx="0.6" fill="#f6f1e7"/>
          <rect x="7" y="10.7" width="3" height="9.3" rx="0.6" fill="#f6f1e7"/>
          <rect x="11" y="8.2" width="3" height="11.8" rx="0.6" fill="#f6f1e7"/>
          <rect x="16" y="7.5" width="3" height="12.5" rx="0.6" fill="#e8a55f" transform="rotate(10 16 20)"/>
          <rect x="2.2" y="20" width="19.6" height="1.6" rx="0.8" fill="#e8a55f"/>
        </svg>
        Watt<b>Library</b>
      </a>
      <nav class="main" aria-label="Main navigation">
        {navLinks.map((l) => (
          <a href={l.href} aria-current={l.match(path) ? 'page' : undefined}>{l.label}</a>
        ))}
      </nav>
    </div>
  </header>
  <slot name="hero" />
  <main id="main-content"><div class="wrap"><slot /></div></main>
  <footer class="site">
    <div class="wrap">
      <div>
        <div class="flogo">Watt<b>Library</b></div>
        <p>An independent, ad-free database of portable power stations. Every spec comes from manufacturer documentation and manuals, with one transparent runtime formula across every page.</p>
        <p>© {new Date().getFullYear()} WattLibrary · <a href="mailto:hello@wattlibrary.com">hello@wattlibrary.com</a></p>
      </div>
      <div>
        <div class="fhead">Database & Tools</div>
        <nav aria-label="Database and tools">
          <a href="/power-stations/">All power stations</a>
          <a href="/calculator/">Runtime &amp; solar calculator</a>
          <a href="/compare/">Head-to-head comparisons</a>
          <a href="/brands/">Brands</a>
          <a href="/about/">About &amp; methodology</a>
        </nav>
      </div>
      <div>
        <div class="fhead">Worked Guides</div>
        <nav aria-label="Appliance guides">
          <a href="/guides/power-station-for-cpap/">Power station for CPAP</a>
          <a href="/guides/power-station-for-refrigerator/">Power station for refrigerator</a>
          <a href="/guides/power-station-for-starlink/">Power station for Starlink</a>
          <a href="/guides/power-station-for-home-office-ups/">Home office &amp; UPS backup</a>
          <a href="/guides/power-station-for-space-heater/">Power station for space heater</a>
          <a href="/guides/solar-panel-compatibility/">Solar MPPT compatibility</a>
        </nav>
      </div>
    </div>
  </footer>
</body>
</html>
