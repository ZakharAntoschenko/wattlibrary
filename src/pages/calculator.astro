---
import Base from '../layouts/Base.astro';
import db from '../data/power_stations.json';
import { metaFromParts, GUIDE_URLS } from '../lib/utils.js';

const stations = [...db.power_stations].sort((a, b) => a.capacity_wh - b.capacity_wh);
const count = stations.length;

const title = 'Power Station Runtime & Solar MPPT Calculator';
const description = metaFromParts([
  `Size a portable power station for your exact appliances (with compressor surge check) and test solar panel cold-weather Voc against all ${count} verified models.`,
]);

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: title,
      description,
      url: new URL(Astro.url.pathname, Astro.site).href,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Any',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
        { '@type': 'ListItem', position: 2, name: 'Calculator' },
      ],
    },
  ],
};

const presets = [
  { id: 'fridge', name: 'Full-size refrigerator', avgW: 60, runW: 150, surgeW: 900, defaultOn: true, note: '60W 24h avg · 900W start' },
  { id: 'freezer', name: 'Chest freezer', avgW: 50, runW: 130, surgeW: 800, defaultOn: false, note: '50W 24h avg · 800W start' },
  { id: 'wifi', name: 'Wi-Fi router + modem', avgW: 15, runW: 15, surgeW: 15, defaultOn: true, note: '15W continuous' },
  { id: 'cpap', name: 'CPAP (no humidifier)', avgW: 40, runW: 40, surgeW: 40, defaultOn: false, note: '40W continuous' },
  { id: 'cpap_h', name: 'CPAP (humidifier + tube)', avgW: 85, runW: 85, surgeW: 85, defaultOn: false, note: '85W continuous' },
  { id: 'starlink', name: 'Starlink Standard Gen 3', avgW: 55, runW: 55, surgeW: 75, defaultOn: false, note: '55W average' },
  { id: 'starlink_m', name: 'Starlink Mini', avgW: 25, runW: 25, surgeW: 35, defaultOn: false, note: '25W average' },
  { id: 'laptop', name: 'Laptop + monitor', avgW: 75, runW: 75, surgeW: 75, defaultOn: true, note: '75W average' },
  { id: 'desktop', name: 'Desktop PC + monitor', avgW: 200, runW: 200, surgeW: 300, defaultOn: false, note: '200W average' },
  { id: 'tv', name: '55" LED TV', avgW: 100, runW: 100, surgeW: 100, defaultOn: false, note: '100W average' },
  { id: 'microwave', name: 'Microwave (700W)', avgW: 1000, runW: 1000, surgeW: 1200, defaultOn: false, note: '1,000W draw' },
  { id: 'heater', name: 'Space heater (high)', avgW: 1500, runW: 1500, surgeW: 1500, defaultOn: false, note: '1,500W resistive' },
];
---
<Base {title} {description} {schema}>
  <nav class="crumbs"><a href="/">Home</a> › Calculator</nav>
  <h1>Runtime &amp; solar MPPT calculator</h1>
  <p class="lead">
    Two calculators wired directly into all {count} verified power stations: size a battery for your combined appliances,
    or test whether your solar panel array fits each unit's MPPT voltage window — even in freezing weather.
  </p>

  <div class="btn-row" style="margin:.6rem 0 1.2rem;">
    <a href="#runtime" class="btn btn-sm">1. Appliance Runtime &amp; Sizing</a>
    <a href="#solar" class="btn btn-ghost btn-sm">2. Solar Panel MPPT Voc Checker</a>
  </div>

  <section id="runtime">
    <h2>1. Appliance runtime &amp; station sizing</h2>
    <div class="tool-panel">
      <p style="margin:0 0 .65rem; font-size:.9rem; font-weight:650;">Toggle appliances you want to run together:</p>
      <div class="filters" id="preset-chips" style="margin-top:0;">
        {presets.map((p) => (
          <button
            type="button"
            class={p.defaultOn ? 'active' : ''}
            data-id={p.id}
            data-avg={p.avgW}
            data-run={p.runW}
            data-surge={p.surgeW}
            title={p.note}
          >
            {p.name} ({p.avgW}W)
          </button>
        ))}
      </div>

      <div class="tool-row" style="margin-top:.85rem;">
        <div class="field">
          <label for="c-custom-w">Extra custom load (W)</label>
          <input id="c-custom-w" type="number" min="0" max="6000" step="5" value="0" />
        </div>
        <div class="field">
          <label for="c-hours">Target runtime (hours)</label>
          <input id="c-hours" type="number" min="1" max="168" step="1" value="12" />
        </div>
        <div class="field">
          <label for="c-eff">Outlet type</label>
          <select id="c-eff">
            <option value="0.85">AC outlets (85% inverter eff.)</option>
            <option value="0.95">12V DC / USB-C only (95% eff.)</option>
          </select>
        </div>
        <div class="field">
          <label for="c-filter">Show stations</label>
          <select id="c-filter">
            <option value="fit">Only stations that meet target</option>
            <option value="all">All {count} stations</option>
          </select>
        </div>
      </div>
    </div>

    <div class="kpis" id="rt-kpis">
      <div class="kpi"><b id="k-avg">—</b> average draw</div>
      <div class="kpi"><b id="k-surge">—</b> peak surge required</div>
      <div class="kpi"><b id="k-wh">—</b> rated Wh needed</div>
      <div class="kpi"><b id="k-pass">—</b> models meet target</div>
    </div>

    <div class="tbl tbl-sticky"><div class="tbl-scroll"><table>
      <thead>
        <tr>
          <th>Model</th>
          <th>Status</th>
          <th>Est. runtime</th>
          <th>Capacity</th>
          <th>AC / Surge</th>
          <th>Weight</th>
          <th>Launch MSRP</th>
        </tr>
      </thead>
      <tbody id="rt-tbody"></tbody>
    </table></div></div>
    <p class="muted" style="font-size:.84rem;">
      Formula: <code>capacity_wh × efficiency ÷ total_average_watts</code> (rounded down). Startup surge check requires the station's surge rating to cover the highest single compressor restart plus the other running loads.
    </p>
  </section>

  <section id="solar" style="margin-top:2.8rem;">
    <h2>2. Solar panel MPPT voltage (Voc) checker</h2>
    <p style="max-width:680px;">
      Exceeding a power station's maximum solar input voltage (<strong>Voc</strong>) can permanently damage its MPPT controller —
      and cold winter air pushes panel voltage <strong>up</strong> by roughly 0.35% per °C below 25°C (77°F). Enter your panel specs
      below to see which of our {count} models are safe and how fast they recharge.
    </p>

    <div class="tool-panel">
      <div class="tool-row">
        <div class="field">
          <label for="s-voc">Single panel Voc (V)</label>
          <input id="s-voc" type="number" min="5" max="150" step="0.5" value="23" />
        </div>
        <div class="field">
          <label for="s-watts">Single panel wattage (W)</label>
          <input id="s-watts" type="number" min="20" max="800" step="10" value="200" />
        </div>
        <div class="field">
          <label for="s-series">Panels in series (S)</label>
          <input id="s-series" type="number" min="1" max="6" step="1" value="2" />
        </div>
        <div class="field">
          <label for="s-parallel">Parallel strings (P)</label>
          <input id="s-parallel" type="number" min="1" max="6" step="1" value="1" />
        </div>
        <div class="field">
          <label for="s-temp">Coldest morning temp</label>
          <select id="s-temp">
            <option value="25">77°F / 25°C (STC lab)</option>
            <option value="10">50°F / 10°C (mild)</option>
            <option value="0" selected>32°F / 0°C (freezing)</option>
            <option value="-10">14°F / -10°C (cold winter)</option>
            <option value="-20">-4°F / -20°C (extreme cold)</option>
          </select>
        </div>
      </div>
    </div>

    <div class="kpis">
      <div class="kpi"><b id="ks-voc">—</b> STC array Voc</div>
      <div class="kpi"><b id="ks-cold">—</b> cold-adjusted Voc</div>
      <div class="kpi"><b id="ks-watts">—</b> total array watts</div>
      <div class="kpi"><b id="ks-ok">—</b> safe stations</div>
    </div>

    <div class="tbl tbl-sticky"><div class="tbl-scroll"><table>
      <thead>
        <tr>
          <th>Model</th>
          <th>MPPT Verdict</th>
          <th>Voltage Window</th>
          <th>Max Solar In</th>
          <th>0–100% Sun Hrs*</th>
          <th>Connector</th>
        </tr>
      </thead>
      <tbody id="sol-tbody"></tbody>
    </table></div></div>
    <p class="muted" style="font-size:.84rem;">
      * Estimated peak sun hours at 78% real-world panel + MPPT harvest factor, capped at each station's max solar input wattage.
      Read the full <a href={GUIDE_URLS.solar}>Solar Panel Compatibility &amp; MPPT Guide →</a> for wiring rules and connector adapters.
    </p>
  </section>

  <script define:vars={{ stationsData: stations }}>
    const lbs = (kg) => (kg * 2.20462).toFixed(1);
    const parseWin = (range) => {
      const m = String(range || '').match(/(\d+(?:\.\d+)?)\s*[-–]\s*(\d+(?:\.\d+)?)/);
      return m ? { min: Number(m[1]), max: Number(m[2]) } : { min: 11, max: 60 };
    };
    const fmtRt = (h) => {
      if (h >= 48) return `${Math.floor((h / 24) * 10) / 10} days (${Math.floor(h)} h)`;
      if (h >= 10) return `${Math.floor(h)} hours`;
      if (h >= 1) return `${Math.floor(h * 10) / 10} hours`;
      return `${Math.floor(h * 60)} min`;
    };

    // ---------- 1. Runtime calculator ----------
    const chipBtns = Array.from(document.querySelectorAll('#preset-chips button'));
    const customWEl = document.getElementById('c-custom-w');
    const hoursEl = document.getElementById('c-hours');
    const effEl = document.getElementById('c-eff');
    const filterEl = document.getElementById('c-filter');
    const rtTbody = document.getElementById('rt-tbody');

    function updateRuntime() {
      let avgW = Number(customWEl.value) || 0;
      let runW = avgW;
      let maxExtraSurge = 0;

      for (const b of chipBtns) {
        if (!b.classList.contains('active')) continue;
        const a = Number(b.dataset.avg);
        const r = Number(b.dataset.run);
        const sg = Number(b.dataset.surge);
        avgW += a;
        runW += r;
        if (sg - r > maxExtraSurge) maxExtraSurge = sg - r;
      }

      const targetH = Math.max(1, Number(hoursEl.value) || 1);
      const eff = Number(effEl.value) || 0.85;
      const peakSurge = runW + maxExtraSurge;
      const neededWh = avgW > 0 ? Math.ceil((avgW * targetH) / eff) : 0;

      document.getElementById('k-avg').textContent = `${avgW.toLocaleString()} W`;
      document.getElementById('k-surge').textContent = `${peakSurge.toLocaleString()} W`;
      document.getElementById('k-wh').textContent = `${neededWh.toLocaleString()} Wh`;

      const rows = stationsData.map((s) => {
        const effOut = s.boost_mode_w && s.boost_mode_w > s.ac_output_w ? s.boost_mode_w : s.ac_output_w;
        if (avgW <= 0) {
          return { s, ok: true, badge: 'badge-ok', status: 'Ready', rtText: '—', hrs: 9999 };
        }
        if (eff < 0.9 && peakSurge > s.ac_surge_w) {
          return { s, ok: false, badge: 'badge-bad', status: `Can't start (${s.ac_surge_w}W surge)`, rtText: '—', hrs: -2 };
        }
        if (eff < 0.9 && runW > effOut) {
          return { s, ok: false, badge: 'badge-bad', status: `Exceeds ${effOut}W output`, rtText: '—', hrs: -1 };
        }
        const hrs = (s.capacity_wh * eff) / avgW;
        if (hrs >= targetH) {
          const boost = eff < 0.9 && runW > s.ac_output_w ? ' (boost)' : '';
          return { s, ok: true, badge: 'badge-ok', status: `Fits ${targetH}h target${boost}`, rtText: fmtRt(hrs), hrs };
        }
        return { s, ok: false, badge: 'badge-warn', status: `Short (${Math.floor((hrs / targetH) * 100)}% of target)`, rtText: fmtRt(hrs), hrs };
      });

      const passCount = rows.filter((r) => r.ok).length;
      document.getElementById('k-pass').textContent = `${passCount} of ${stationsData.length}`;

      const showOnlyFit = filterEl.value === 'fit';
      const display = showOnlyFit ? rows.filter((r) => r.ok) : rows;
      if (display.length === 0) {
        rtTbody.innerHTML = '<tr><td colspan="7" class="muted">No single station in the database meets this combined load + duration. Switch "Show stations" to All, reduce hours, or pair a large station with expansion batteries / solar.</td></tr>';
        return;
      }

      rtTbody.innerHTML = display.map(({ s, badge, status, rtText }) => `
        <tr>
          <td><a href="/power-stations/${s.slug}/">${s.brand} ${s.model}</a></td>
          <td><span class="badge ${badge}">${status}</span></td>
          <td><b>${rtText}</b></td>
          <td>${s.capacity_wh.toLocaleString()} Wh</td>
          <td>${s.ac_output_w.toLocaleString()}W / ${s.ac_surge_w.toLocaleString()}W</td>
          <td>${lbs(s.weight_kg)} lbs <span class="muted">(${s.weight_kg} kg)</span></td>
          <td>$${s.msrp_usd.toLocaleString()}</td>
        </tr>
      `).join('');
    }

    chipBtns.forEach((b) => b.addEventListener('click', () => {
      b.classList.toggle('active');
      updateRuntime();
    }));
    [customWEl, hoursEl, effEl, filterEl].forEach((el) => el.addEventListener('input', updateRuntime));
    [effEl, filterEl].forEach((el) => el.addEventListener('change', updateRuntime));
    updateRuntime();

    // ---------- 2. Solar MPPT Voc checker ----------
    const sVocEl = document.getElementById('s-voc');
    const sWEl = document.getElementById('s-watts');
    const sSerEl = document.getElementById('s-series');
    const sParEl = document.getElementById('s-parallel');
    const sTempEl = document.getElementById('s-temp');
    const solTbody = document.getElementById('sol-tbody');

    function updateSolar() {
      const panelVoc = Math.max(1, Number(sVocEl.value) || 22);
      const panelW = Math.max(10, Number(sWEl.value) || 200);
      const series = Math.max(1, Number(sSerEl.value) || 1);
      const parallel = Math.max(1, Number(sParEl.value) || 1);
      const tempC = Number(sTempEl.value);

      const stcVoc = +(panelVoc * series).toFixed(1);
      // Standard silicon panel Voc temperature coefficient: ~ -0.35% / °C
      const coldFactor = 1 + Math.max(0, 25 - tempC) * 0.0035;
      const coldVoc = +(stcVoc * coldFactor).toFixed(1);
      const totalW = panelW * series * parallel;

      document.getElementById('ks-voc').textContent = `${stcVoc} V`;
      document.getElementById('ks-cold').textContent = `${coldVoc} V`;
      document.getElementById('ks-watts').textContent = `${totalW.toLocaleString()} W`;

      let safeCount = 0;
      const rows = stationsData.map((s) => {
        const win = parseWin(s.solar_voltage_range);
        const effIn = Math.min(totalW, s.solar_input_w) * 0.78;
        const hrs = +(s.capacity_wh / effIn).toFixed(1);

        if (stcVoc > win.max) {
          return { s, badge: 'badge-bad', verdict: `Over-voltage (${stcVoc}V > ${win.max}V)`, hrs: '—', sort: 3 };
        }
        if (coldVoc > win.max) {
          return { s, badge: 'badge-bad', verdict: `Cold Voc unsafe (${coldVoc}V > ${win.max}V)`, hrs: '—', sort: 2 };
        }
        if (stcVoc < win.min) {
          return { s, badge: 'badge-warn', verdict: `Below ${win.min}V start`, hrs: '—', sort: 1 };
        }
        safeCount++;
        const clipped = totalW > s.solar_input_w;
        return {
          s,
          badge: 'badge-ok',
          verdict: clipped ? `Safe (clipped to ${s.solar_input_w}W)` : 'Compatible',
          hrs: `${hrs} h`,
          sort: 0,
        };
      });

      document.getElementById('ks-ok').textContent = `${safeCount} of ${stationsData.length}`;
      rows.sort((a, b) => a.sort - b.sort || a.s.capacity_wh - b.s.capacity_wh);

      solTbody.innerHTML = rows.map(({ s, badge, verdict, hrs }) => `
        <tr>
          <td><a href="/power-stations/${s.slug}/">${s.brand} ${s.model}</a></td>
          <td><span class="badge ${badge}">${verdict}</span></td>
          <td>${s.solar_voltage_range}</td>
          <td>${s.solar_input_w.toLocaleString()} W</td>
          <td><b>${hrs}</b></td>
          <td>${s.dc_input_connector}</td>
        </tr>
      `).join('');
    }

    [sVocEl, sWEl, sSerEl, sParEl, sTempEl].forEach((el) => {
      el.addEventListener('input', updateSolar);
      el.addEventListener('change', updateSolar);
    });
    updateSolar();
  </script>
</Base>
