---
import Base from '../../layouts/Base.astro';
import db from '../../data/power_stations.json';
import pairsData from '../../data/compare_pairs.json';
import { fullName, capacityClass, metaFromParts, pickTitle, GUIDE_URLS } from '../../lib/utils.js';
import { pairSlug, compareRows, compareRuntimeRows, autoVerdict, relatedPairs } from '../../lib/compare.js';

const bySlug = Object.fromEntries(db.power_stations.map((s) => [s.slug, s]));

export function getStaticPaths() {
  const bySlug = Object.fromEntries(db.power_stations.map((s) => [s.slug, s]));
  return pairsData.pairs.map((p) => {
    const a = bySlug[p.a];
    const b = bySlug[p.b];
    if (!a || !b) throw new Error(`Unknown slug in compare_pairs.json: ${p.a} / ${p.b}`);
    return {
      params: { pair: pairSlug(a, b) },
      props: {
        a,
        b,
        manualVerdict: p.verdict ?? null,
        pickA: p.pick_a ?? null,
        pickB: p.pick_b ?? null,
        indexable: p.index === true,
      },
    };
  });
}

const { a, b, manualVerdict, pickA, pickB, indexable } = Astro.props;
const an = fullName(a);
const bn = fullName(b);
const rows = compareRows(a, b);
const runtimeRows = compareRuntimeRows(a, b);
const verdict = manualVerdict ? [manualVerdict] : autoVerdict(a, b);
const aWins = rows.filter((r) => r[3] === 1).length;
const bWins = rows.filter((r) => r[3] === -1).length;
const related = relatedPairs(a, b, pairsData.pairs, bySlug);

const leader = aWins === bWins ? null : aWins > bWins ? an : bn;
const title = pickTitle([
  `${an} vs ${bn}: ${a.capacity_wh.toLocaleString()} vs ${b.capacity_wh.toLocaleString()}Wh`,
  `${an} vs ${bn}`,
]);
const description = metaFromParts([
  `${an} (${a.capacity_wh.toLocaleString()}Wh/${a.ac_output_w.toLocaleString()}W) vs ${bn} (${b.capacity_wh.toLocaleString()}Wh/${b.ac_output_w.toLocaleString()}W).`,
  leader
    ? `${leader} wins ${Math.max(aWins, bWins)} of ${rows.length} spec rows.`
    : `Even on spec rows (${aWins}–${bWins}).`,
  'Specs, fridge & CPAP runtimes, solar recharge, and verdict.',
]);

// Article + BreadcrumbList only (no standalone Product nodes lacking offers/review).
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: `${an} vs ${bn}`,
      description,
      url: new URL(Astro.url.pathname, Astro.site).href,
      dateModified: db.updated,
      author: { '@type': 'Organization', name: 'WattLibrary' },
      publisher: { '@type': 'Organization', name: 'WattLibrary' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Comparisons', item: new URL('/compare/', Astro.site).href },
        { '@type': 'ListItem', position: 2, name: `${an} vs ${bn}` },
      ],
    },
  ],
};
---
<Base {title} {description} {schema} noindex={!indexable} ogType="article">
  <nav class="crumbs"><a href="/compare/">Comparisons</a> › {an} vs {bn}</nav>
  <h1>{an} vs {bn}</h1>
  <p class="muted">
    {capacityClass(a.capacity_wh)}{capacityClass(a.capacity_wh) !== capacityClass(b.capacity_wh) ? ` vs ${capacityClass(b.capacity_wh)}` : ''} ·
    verified specs + real-world runtimes, winner marked per row
  </p>

  <h2>Verdict</h2>
  {verdict.map((p) => <p style="max-width:680px;">{p}</p>)}

  {(pickA || pickB) && (
    <div class="split-2">
      {pickA && (
        <div class="pick-box">
          <h3>Choose the {an} if…</h3>
          <p>{pickA}</p>
        </div>
      )}
      {pickB && (
        <div class="pick-box">
          <h3>Choose the {bn} if…</h3>
          <p>{pickB}</p>
        </div>
      )}
    </div>
  )}

  <h2>Real-world runtimes &amp; solar recharge</h2>
  <p class="muted" style="font-size:0.86rem;">
    Modeled with the same formula used across all WattLibrary <a href="/guides/">guides</a> (85% AC / 95% DC efficiency, compressor surge check, 78% real-world solar factor).
  </p>
  <div class="tbl"><div class="tbl-scroll"><table>
    <thead>
      <tr>
        <th>Scenario</th>
        <th><a href={`/power-stations/${a.slug}/`}>{an}</a></th>
        <th><a href={`/power-stations/${b.slug}/`}>{bn}</a></th>
      </tr>
    </thead>
    <tbody>
      {runtimeRows.map(([label, av, bv, w]) => (
        <tr>
          <th>{label}</th>
          <td class={w === 1 ? 'win' : ''}>{av}{w === 1 ? ' ✓' : ''}</td>
          <td class={w === -1 ? 'win' : ''}>{bv}{w === -1 ? ' ✓' : ''}</td>
        </tr>
      ))}
    </tbody>
  </table></div></div>

  <h2>Side-by-side specifications</h2>
  <p class="muted" style="font-size:0.86rem;">✓ marks the better number in each row ({an}: {aWins} wins · {bn}: {bWins} wins — weigh the rows that match <em>your</em> use, not the raw score).</p>
  <div class="tbl"><div class="tbl-scroll"><table>
    <thead>
      <tr>
        <th>Specification</th>
        <th><a href={`/power-stations/${a.slug}/`}>{an}</a></th>
        <th><a href={`/power-stations/${b.slug}/`}>{bn}</a></th>
      </tr>
    </thead>
    <tbody>
      {rows.map(([label, av, bv, w]) => (
        <tr>
          <th>{label}</th>
          <td class={w === 1 ? 'win' : ''}>{av}{w === 1 ? ' ✓' : ''}</td>
          <td class={w === -1 ? 'win' : ''}>{bv}{w === -1 ? ' ✓' : ''}</td>
        </tr>
      ))}
    </tbody>
  </table></div></div>

  <h2>Dig deeper</h2>
  <div class="grid">
    <div class="card">
      <a href={`/power-stations/${a.slug}/`}>{an} — full specs &amp; runtimes →</a>
    </div>
    <div class="card">
      <a href={`/power-stations/${b.slug}/`}>{bn} — full specs &amp; runtimes →</a>
    </div>
    <div class="card">
      <a href="/calculator/">Test your own load in the Calculator →</a>
      <p class="sub">Combine appliances or check your solar panel Voc</p>
    </div>
  </div>

  {related.length > 0 && (
    <>
      <h2>Related comparisons</h2>
      <p class="muted">Other matchups involving these models and units in the same size class.</p>
      <div class="grid">
        {related.map((r) => (
          <div class="card">
            <a href={r.url}>{r.label}</a>
            <p class="sub">{r.sub}</p>
          </div>
        ))}
      </div>
      <p><a href="/compare/">Compare any two models →</a> · <a href={GUIDE_URLS.solar}>Solar MPPT guide →</a></p>
    </>
  )}

  <div class="disclosure">
    Specifications verified ({db.updated}) from manufacturer documentation (<a href={a.brand_product_url} rel="nofollow noopener">{a.brand}</a>, <a href={b.brand_product_url} rel="nofollow noopener">{b.brand}</a>). Launch prices shown; street prices move often.
  </div>
</Base>
