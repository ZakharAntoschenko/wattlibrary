---
import Base from '../../layouts/Base.astro';
import db from '../../data/power_stations.json';
import pairsData from '../../data/compare_pairs.json';
import {
  APPLIANCES, runtimeHours, formatRuntime, dollarsPerWh, whPerKg,
  fullName, alternatives, sameBrandSiblings, capacityClass, effectiveOutput,
  metaFromParts, headlineRuntimes, chemistryLabel, pickTitle,
  applianceRuntime, canStart, COMPRESSOR_LOADS, GUIDE_URLS,
  formatWeight, kgToLbs, brandSlug, parseVoltageWindow, solarChargeHours,
} from '../../lib/utils.js';
import { CPAP_LOADS, CPAP_HOURS_PER_NIGHT, nightsOfCpap, formatNights } from '../../lib/guides.js';

export function getStaticPaths() {
  return db.power_stations.map((station) => ({
    params: { slug: station.slug },
    props: { station },
  }));
}

const { station: s } = Astro.props;
const all = db.power_stations;
const name = fullName(s);
const bSlug = brandSlug(s.brand);
const alts = alternatives(s, all);
const siblings = sameBrandSiblings(s, all);
const othersSorted = all
  .filter((x) => x.slug !== s.slug)
  .sort((a, b) => fullName(a).localeCompare(fullName(b)));

const fullFridge = COMPRESSOR_LOADS.find((l) => l.key === 'full');
const miniFridge = COMPRESSOR_LOADS.find((l) => l.key === 'mini');
const fridgeRt = canStart(s, fullFridge) ? formatRuntime(runtimeHours(s, fullFridge.average_w)) : null;
const miniRt = canStart(s, miniFridge) ? formatRuntime(runtimeHours(s, miniFridge.average_w)) : null;
const cpapLoad = (key) => CPAP_LOADS.find((l) => l.key === key);
const cpapNights = formatNights(nightsOfCpap(s, cpapLoad('ac')));
const cpapNightsDc = formatNights(nightsOfCpap(s, cpapLoad('dc')));
const cpapNightsHumid = formatNights(nightsOfCpap(s, cpapLoad('humid')));
const solarFullHrs = solarChargeHours(s);
const mppt = parseVoltageWindow(s.solar_voltage_range);

const bySlug = Object.fromEntries(all.map((x) => [x.slug, x]));
// Prioritize indexable curated comparisons, and map curated pair URLs for quick compare dropdown.
const allPairsForModel = pairsData.pairs
  .filter((p) => p.a === s.slug || p.b === s.slug)
  .sort((x, y) => Number(y.index === true) - Number(x.index === true))
  .map((p) => ({
    url: `/compare/${p.a}-vs-${p.b}/`,
    other: bySlug[p.a === s.slug ? p.b : p.a],
    indexable: p.index === true,
  }));
const curatedComparisons = allPairsForModel.filter((p) => p.indexable);
const displayComparisons = curatedComparisons.length > 0 ? curatedComparisons : allPairsForModel.slice(0, 3);
const pairUrlMap = Object.fromEntries(allPairsForModel.map((p) => [p.other.slug, p.url]));

const wh = s.capacity_wh.toLocaleString();
const acw = s.ac_output_w.toLocaleString();
const title = pickTitle([
  `${name}: ${wh}Wh, ${acw}W — Specs & Runtimes`,
  `${name}: ${wh}Wh, ${acw}W Specs & Runtimes`,
  `${name} Specs: ${wh}Wh, ${acw}W`,
]);

const chargeMin = s.ac_charge_minutes_0_80;
const chargeText = chargeMin ? (chargeMin >= 90 ? `${+(chargeMin / 60).toFixed(1)} h` : `${chargeMin} min`) : null;

const rt = headlineRuntimes(s);
const runtimeLine = rt.length
  ? `Runs ${rt[0].phrase} ~${rt[0].text}${rt[1] ? `, ${rt[1].phrase} ~${rt[1].text}` : ''}.`
  : null;
const description = metaFromParts([
  `${name}: ${wh}Wh ${chemistryLabel(s)}, ${acw}W AC${s.boost_mode_w ? ` (${s.boost_mode_w.toLocaleString()}W boost)` : ''}.`,
  runtimeLine,
  chargeText ? `0–80% in ${chargeText}.` : null,
  `${s.solar_input_w.toLocaleString()}W solar in.`,
  `Full specs + runtime & solar calculator.`,
]);

const faq = [
  {
    q: `How long will the ${name} run a refrigerator?`,
    a: fridgeRt
      ? `About ${fridgeRt} on a full-size refrigerator. A fridge's compressor pulls around ${fullFridge.running_w}W while it runs but only runs about a third of the time, so the pack sees a 24-hour average of roughly ${fullFridge.average_w}W (at ~85% inverter efficiency). The ${s.ac_surge_w.toLocaleString()}W surge rating covers the ~${fullFridge.surge_w}W a compressor asks for at each restart. For your own fridge, divide the kWh/year on its EnergyGuide label by 8,760.`
      : `Probably not a full-size one. A fridge compressor asks for roughly ${fullFridge.surge_w}W for a second or two at every restart, above this unit's ${s.ac_surge_w.toLocaleString()}W surge rating, so it is likely to trip whatever its capacity.${miniRt ? ` It can run a mini fridge for about ${miniRt}.` : ''}`,
    link: { href: GUIDE_URLS.fridge, text: `Fridge runtimes for all ${all.length} models` },
  },
  ...(cpapNights
    ? [{
        q: `How many nights will the ${name} run a CPAP?`,
        a: `About ${cpapNights} nights from the AC outlet at ${cpapLoad('ac').watts}W with the humidifier off (${CPAP_HOURS_PER_NIGHT} hours a night), or ${cpapNightsDc} from the 12V DC outlet, which skips the inverter. A heated humidifier and tube push the draw to around ${cpapLoad('humid').watts}W${cpapNightsHumid ? ` and cut that to ${cpapNightsHumid} nights` : ''}.`,
        link: { href: GUIDE_URLS.cpap, text: `CPAP nights for all ${all.length} models` },
      }]
    : []),
  {
    q: `Does the ${name} use a LiFePO4 battery?`,
    a: s.chemistry === 'LFP'
      ? `Yes. It uses LiFePO4 (LFP) cells rated for about ${s.cycles_to_80pct.toLocaleString()} cycles to 80% capacity — roughly ${Math.round(s.cycles_to_80pct / 365)}+ years of daily cycling.`
      : `No. It uses NMC lithium-ion cells rated for about ${s.cycles_to_80pct.toLocaleString()} cycles to 80% capacity, which is a shorter service life than modern LiFePO4 models.`,
  },
  {
    q: `What solar panels work with the ${name}?`,
    a: `Any panel (or array) whose cold-weather open-circuit voltage (Voc) stays inside its ${s.solar_voltage_range} MPPT window and up to ${s.solar_input_w.toLocaleString()}W, connected via ${s.dc_input_connector}. Never exceed ${mppt.max}V Voc — exceeding the voltage ceiling can damage the charge controller.`,
    link: { href: GUIDE_URLS.solar, text: 'Solar MPPT compatibility guide' },
  },
  {
    q: `How fast does the ${name} recharge from a wall outlet?`,
    a: s.ac_charge_minutes_0_80
      ? `About ${s.ac_charge_minutes_0_80} minutes from 0 to 80% on AC power.`
      : `The manufacturer does not quote a standard 0–80% AC time for this model.`,
  },
];

// TechArticle + BreadcrumbList (avoiding standalone Product without offers/review
// which triggers critical merchant structured-data errors in Google Search Console).
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TechArticle',
      headline: title,
      description,
      url: new URL(Astro.url.pathname, Astro.site).href,
      dateModified: db.updated,
      author: { '@type': 'Organization', name: 'WattLibrary' },
      publisher: { '@type': 'Organization', name: 'WattLibrary' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Power stations', item: new URL('/power-stations/', Astro.site).href },
        { '@type': 'ListItem', position: 2, name: s.brand, item: new URL(`/brands/${bSlug}/`, Astro.site).href },
        { '@type': 'ListItem', position: 3, name },
      ],
    },
  ],
};
---
<Base {title} {description} {schema} ogType="article">
  <nav class="crumbs">
    <a href="/power-stations/">Power stations</a> › <a href={`/brands/${bSlug}/`}>{s.brand}</a> › {name}
  </nav>
  <h1>{name}</h1>
  <p class="muted">
    {capacityClass(s.capacity_wh)} · Released {s.release_year} · Launch price ${s.msrp_usd.toLocaleString()} ·
    <a href={`/brands/${bSlug}/`}>All {s.brand} models</a>
  </p>

  <div class="kpis">
    <div class="kpi"><b>{s.capacity_wh.toLocaleString()} Wh</b> capacity</div>
    <div class="kpi"><b>{s.ac_output_w.toLocaleString()} W</b> AC output</div>
    <div class="kpi"><b>{s.chemistry}</b> {s.cycles_to_80pct.toLocaleString()} cycles</div>
    <div class="kpi"><b>${dollarsPerWh(s).toFixed(2)}</b> per Wh</div>
    <div class="kpi"><b>{kgToLbs(s.weight_kg)} lbs</b> ({s.weight_kg} kg)</div>
  </div>

  {s.highlight && <div class="note"><b>Worth knowing:</b> {s.highlight}</div>}

  <div class="tool-panel" style="padding:.8rem 1rem;">
    <div class="tool-row">
      <div class="field" style="flex:2 1 240px;">
        <label for="quick-cmp">Compare {name} side by side with another station</label>
        <select id="quick-cmp">
          <option value="">Choose a station to compare…</option>
          {othersSorted.map((o) => (
            <option value={o.slug}>{fullName(o)} ({o.capacity_wh.toLocaleString()}Wh · {o.ac_output_w.toLocaleString()}W)</option>
          ))}
        </select>
      </div>
      <button type="button" id="quick-cmp-btn" class="btn btn-sm">Compare →</button>
    </div>
  </div>

  <h2>Full specifications</h2>
  <div class="tbl"><div class="tbl-scroll"><table>
    <tbody>
      <tr><th>Battery capacity</th><td>{s.capacity_wh.toLocaleString()} Wh</td></tr>
      <tr><th>Battery chemistry</th><td>{s.chemistry === 'LFP' ? 'LiFePO4 (LFP)' : 'Lithium NMC'} — {s.cycles_to_80pct.toLocaleString()} cycles to 80%</td></tr>
      <tr><th>AC output (continuous)</th><td>{s.ac_output_w.toLocaleString()} W{s.boost_mode_w ? ` (${s.boost_mode_w.toLocaleString()} W in boost mode)` : ''}</td></tr>
      <tr><th>AC output (surge)</th><td>{s.ac_surge_w.toLocaleString()} W</td></tr>
      <tr><th>AC outlets</th><td>{s.ac_outlets}</td></tr>
      <tr><th>Max USB-C power</th><td>{s.usb_c_max_w} W</td></tr>
      <tr><th>240V output</th><td>{s.output_240v ? 'Yes (120V/240V split-phase)' : 'No (120V only)'}</td></tr>
      <tr><th>Max solar input</th><td>{s.solar_input_w.toLocaleString()} W{solarFullHrs ? ` (~${(Math.ceil(solarFullHrs * 10) / 10).toFixed(1)} peak sun hrs 0–100%)` : ''}</td></tr>
      <tr><th>Solar voltage window (MPPT)</th><td>{s.solar_voltage_range}</td></tr>
      <tr><th>DC input connector</th><td>{s.dc_input_connector}</td></tr>
      <tr><th>AC recharge 0–80%</th><td>{s.ac_charge_minutes_0_80 ? `${s.ac_charge_minutes_0_80} min` : 'Not specified'}</td></tr>
      <tr><th>UPS / EPS switchover</th><td>{s.ups_switchover_ms ? `${s.ups_switchover_ms} ms` : 'Not supported'}</td></tr>
      <tr><th>Expandable capacity</th><td>{s.expandable_max_wh ? `Yes — up to ${s.expandable_max_wh.toLocaleString()} Wh` : 'No'}</td></tr>
      <tr><th>Weight</th><td>{formatWeight(s.weight_kg)} · {whPerKg(s).toFixed(0)} Wh/kg</td></tr>
    </tbody>
  </table></div></div>

  <h2>Interactive check for the {name}</h2>
  <div class="split-2">
    <div class="tool-panel" style="margin:0;">
      <h3 style="margin-top:0;">Custom wattage runtime</h3>
      <div class="tool-row">
        <div class="field">
          <label for="m-watts">Load draw (Watts)</label>
          <input id="m-watts" type="number" min="1" max="10000" value="120" />
        </div>
        <div class="field">
          <label for="m-mode">Outlet</label>
          <select id="m-mode">
            <option value="0.85">AC outlet (85% eff.)</option>
            <option value="0.95">12V DC / USB-C (95% eff.)</option>
          </select>
        </div>
      </div>
      <p id="m-rt-out" style="margin:.75rem 0 0; font-size:.95rem;"></p>
    </div>

    <div class="tool-panel" style="margin:0;">
      <h3 style="margin-top:0;">Solar panel Voc check ({s.solar_voltage_range})</h3>
      <div class="tool-row">
        <div class="field">
          <label for="m-voc">Panel Voc (V)</label>
          <input id="m-voc" type="number" min="5" max="200" step="0.5" value="22" />
        </div>
        <div class="field">
          <label for="m-series">Panels in series</label>
          <input id="m-series" type="number" min="1" max="6" value="1" />
        </div>
        <div class="field">
          <label for="m-pw">Total array (W)</label>
          <input id="m-pw" type="number" min="10" max="5000" step="10" value={Math.min(200, s.solar_input_w)} />
        </div>
      </div>
      <p id="m-solar-out" style="margin:.75rem 0 0; font-size:.92rem;"></p>
    </div>
  </div>
  <p class="muted" style="font-size:.86rem; margin-top:-.5rem;">
    Need to combine multiple appliances or check cold-weather Voc across all {all.length} models? Open the <a href="/calculator/">full Runtime &amp; Solar Calculator →</a>
  </p>

  <h2>What can it run, and for how long?</h2>
  <p class="muted">Capacity × 85% inverter efficiency ÷ average draw. Fridges and freezers use their 24-hour average — the compressor only runs about a third of the time — and count only if this unit's surge rating can restart the compressor. Estimates from specifications, not bench measurements.</p>
  <div class="tbl"><div class="tbl-scroll"><table>
    <thead><tr><th>Appliance</th><th>Typical draw</th><th>Estimated runtime</th></tr></thead>
    <tbody>
      {APPLIANCES.map((a) => {
        const { hours, reason } = applianceRuntime(s, a);
        return (
          <tr>
            <td>{a.guide ? <a href={a.guide}>{a.name}</a> : a.name}</td>
            <td>{a.load ? <>{a.watts} W avg <span class="muted">· ~{a.load.surge_w.toLocaleString()} W to start</span></> : `${a.watts} W`}</td>
            <td>{hours !== null
              ? formatRuntime(hours)
              : reason === 'surge'
                ? <span class="muted">Can't start it ({s.ac_surge_w.toLocaleString()}W surge)</span>
                : <span class="muted">Exceeds {effectiveOutput(s).toLocaleString()}W output</span>}</td>
          </tr>
        );
      })}
    </tbody>
  </table></div></div>
  {cpapNights && <p>For CPAP users: that's roughly <b>{cpapNights} nights</b> of sleep (8h/night, humidifier off, AC outlet){cpapNightsDc && <>, or <b>{cpapNightsDc}</b> from the 12V DC outlet</>}.</p>}
  <p>
    Worked guides across all {all.length} models:
    <a href={GUIDE_URLS.cpap}>CPAP</a> ·
    <a href={GUIDE_URLS.fridge}>Refrigerator</a> ·
    <a href={GUIDE_URLS.starlink}>Starlink</a> ·
    <a href={GUIDE_URLS.ups}>Home office UPS</a> ·
    <a href={GUIDE_URLS.heater}>Space heater</a> ·
    <a href={GUIDE_URLS.solar}>Solar MPPT</a>.
  </p>

  <h2>Closest alternatives</h2>
  <div class="grid">
    {alts.map((alt) => (
      <div class="card">
        <a href={`/power-stations/${alt.slug}/`}>{fullName(alt)}</a>
        <p class="sub">{alt.capacity_wh.toLocaleString()}Wh · {alt.ac_output_w.toLocaleString()}W · {alt.chemistry} · {kgToLbs(alt.weight_kg)} lbs</p>
      </div>
    ))}
  </div>

  {siblings.length > 0 && (
    <>
      <h2>Other {s.brand} models</h2>
      <div class="grid">
        {siblings.map((sb) => (
          <div class="card">
            <a href={`/power-stations/${sb.slug}/`}>{fullName(sb)} specs &amp; runtimes</a>
            <p class="sub">{sb.capacity_wh.toLocaleString()}Wh · {sb.ac_output_w.toLocaleString()}W · {sb.chemistry}</p>
          </div>
        ))}
      </div>
    </>
  )}

  {displayComparisons.length > 0 && (
    <>
      <h2>Head-to-head comparisons</h2>
      <div class="grid">
        {displayComparisons.map((c) => (
          <div class="card">
            <a href={c.url}>{name} vs {fullName(c.other)} →</a>
            <p class="sub">{s.capacity_wh.toLocaleString()}Wh vs {c.other.capacity_wh.toLocaleString()}Wh</p>
          </div>
        ))}
      </div>
    </>
  )}

  <h2>FAQ</h2>
  {faq.map((f) => (
    <details class="faq">
      <summary>{f.q}</summary>
      <div>{f.a}{f.link && <> <a href={f.link.href}>{f.link.text} →</a></>}</div>
    </details>
  ))}

  <div class="disclosure">
    Specifications verified ({db.updated}) from {s.brand}'s official documentation (<a href={s.brand_product_url} rel="nofollow noopener">source</a>). Spotted an error? <a href="mailto:hello@wattlibrary.com">Tell us</a> — verified corrections ship within 24 hours.
  </div>

  <script define:vars={{
    slug: s.slug,
    capWh: s.capacity_wh,
    acOut: s.ac_output_w,
    effOut: effectiveOutput(s),
    solarMaxW: s.solar_input_w,
    vMin: mppt.min,
    vMax: mppt.max,
    pairUrlMap,
  }}>
    // Quick compare redirect
    const cmpSel = document.getElementById('quick-cmp');
    document.getElementById('quick-cmp-btn').addEventListener('click', () => {
      const other = cmpSel.value;
      if (!other) return;
      window.location.href = pairUrlMap[other] ?? `/compare/?a=${encodeURIComponent(slug)}&b=${encodeURIComponent(other)}`;
    });

    // Mini runtime calculator
    const wEl = document.getElementById('m-watts');
    const modeEl = document.getElementById('m-mode');
    const rtOut = document.getElementById('m-rt-out');

    function fmtHours(h) {
      if (h >= 48) return `${(Math.floor((h / 24) * 10) / 10)} days (${Math.floor(h)} h)`;
      if (h >= 10) return `${Math.floor(h)} hours`;
      if (h >= 1) return `${(Math.floor(h * 10) / 10)} hours`;
      return `${Math.floor(h * 60)} minutes`;
    }

    function updateRt() {
      const w = Number(wEl.value);
      const eff = Number(modeEl.value);
      if (!w || w <= 0) { rtOut.innerHTML = '<span class="muted">Enter a wattage above 0.</span>'; return; }
      if (eff < 0.9 && w > effOut) {
        rtOut.innerHTML = `<span class="badge badge-bad">Exceeds limit</span> ${w}W exceeds this station's ${effOut.toLocaleString()}W max output.`;
        return;
      }
      const h = (capWh * eff) / w;
      const boostNote = eff < 0.9 && w > acOut
        ? ` <span class="badge badge-warn">Boost mode only</span> (above ${acOut}W rated AC — resistive loads only)`
        : '';
      rtOut.innerHTML = `Estimated runtime: <b>${fmtHours(h)}</b>${boostNote}`;
    }
    wEl.addEventListener('input', updateRt);
    modeEl.addEventListener('change', updateRt);
    updateRt();

    // Mini solar Voc checker (includes +10% cold-weather margin at ~32°F/0°C)
    const vocEl = document.getElementById('m-voc');
    const serEl = document.getElementById('m-series');
    const pwEl = document.getElementById('m-pw');
    const solOut = document.getElementById('m-solar-out');

    function updateSolar() {
      const voc = Number(vocEl.value);
      const ser = Math.max(1, Number(serEl.value) || 1);
      const pw = Number(pwEl.value);
      if (!voc || !pw) return;
      const arrayVoc = voc * ser;
      const coldVoc = +(arrayVoc * 1.10).toFixed(1);
      const usableW = Math.min(pw, solarMaxW) * 0.78;
      const hrs = +(capWh / usableW).toFixed(1);

      if (arrayVoc > vMax) {
        solOut.innerHTML = `<span class="badge badge-bad">Unsafe — Over-voltage</span> ${arrayVoc}V exceeds the ${vMax}V MPPT ceiling. Wire in parallel or use fewer panels in series.`;
      } else if (coldVoc > vMax) {
        solOut.innerHTML = `<span class="badge badge-warn">Risky in freezing weather</span> ${arrayVoc}V fits at room temp, but reaches ~${coldVoc}V at 32°F (above ${vMax}V limit).`;
      } else if (arrayVoc < vMin) {
        solOut.innerHTML = `<span class="badge badge-warn">Too low</span> ${arrayVoc}V is below the ${vMin}V MPPT start voltage.`;
      } else {
        const clipNote = pw > solarMaxW ? ` (clipped to ${solarMaxW}W max — safe if voltage stays in range)` : '';
        solOut.innerHTML = `<span class="badge badge-ok">Compatible</span> ${arrayVoc}V (~${coldVoc}V cold) fits ${vMin}–${vMax}V. Refills 0–100% in ~<b>${hrs} peak sun hrs</b>${clipNote}.`;
      }
    }
    vocEl.addEventListener('input', updateSolar);
    serEl.addEventListener('input', updateSolar);
    pwEl.addEventListener('input', updateSolar);
    updateSolar();
  </script>
</Base>
