---
import Base from '../../layouts/Base.astro';
import db from '../../data/power_stations.json';
import pairsData from '../../data/compare_pairs.json';
import {
  APPLIANCES, runtimeHours, formatRuntime, dollarsPerWh, whPerKg,
  fullName, alternatives, sameBrandSiblings, capacityClass, effectiveOutput,
  metaFromParts, headlineRuntimes, chemistryLabel, pickTitle,
  applianceRuntime, canStart, COMPRESSOR_LOADS, GUIDE_URLS,
} from '../../lib/utils.js';
import { CPAP_LOADS, CPAP_HOURS_PER_NIGHT, nightsOfCpap, formatNights } from '../../lib/guides.js';

export function getStaticPaths() {
  return db.power_stations.map((station) => ({
    params: { slug: station.slug },
    props: { station },
  }));
}

const { station: s } = Astro.props;
const all = db.power_stations;
const name = fullName(s);
const alts = alternatives(s, all);
const siblings = sameBrandSiblings(s, all);
// Fridge and CPAP numbers come from the same helpers as the guides, so the
// card and /guides/ always quote the same runtime for the same model.
const fullFridge = COMPRESSOR_LOADS.find((l) => l.key === 'full');
const miniFridge = COMPRESSOR_LOADS.find((l) => l.key === 'mini');
const fridgeRt = canStart(s, fullFridge) ? formatRuntime(runtimeHours(s, fullFridge.average_w)) : null;
const miniRt = canStart(s, miniFridge) ? formatRuntime(runtimeHours(s, miniFridge.average_w)) : null;
const cpapLoad = (key) => CPAP_LOADS.find((l) => l.key === key);
const cpapNights = formatNights(nightsOfCpap(s, cpapLoad('ac')));
const cpapNightsDc = formatNights(nightsOfCpap(s, cpapLoad('dc')));
const cpapNightsHumid = formatNights(nightsOfCpap(s, cpapLoad('humid')));

const bySlug = Object.fromEntries(all.map((x) => [x.slug, x]));
const comparisons = pairsData.pairs
  .filter((p) => p.a === s.slug || p.b === s.slug)
  .map((p) => ({
    url: `/compare/${p.a}-vs-${p.b}/`,
    other: bySlug[p.a === s.slug ? p.b : p.a],
  }));

// Title and description lead with the two numbers people actually type
// ("<model> 1024wh", "<model> 1800w") instead of a generic "Specs & Runtimes",
// and the description answers the runtime question in the snippet itself.
const wh = s.capacity_wh.toLocaleString();
const acw = s.ac_output_w.toLocaleString();
const title = pickTitle([
  `${name}: ${wh}Wh, ${acw}W — Specs & Runtimes`,
  `${name}: ${wh}Wh, ${acw}W Specs & Runtimes`,
  `${name} Specs: ${wh}Wh, ${acw}W`,
]);

const chargeMin = s.ac_charge_minutes_0_80;
const chargeText = chargeMin ? (chargeMin >= 90 ? `${+(chargeMin / 60).toFixed(1)} h` : `${chargeMin} min`) : null;

const rt = headlineRuntimes(s);
const runtimeLine = rt.length
  ? `Runs ${rt[0].phrase} ~${rt[0].text}${rt[1] ? `, ${rt[1].phrase} ~${rt[1].text}` : ''}.`
  : null;
const description = metaFromParts([
  `${name}: ${wh}Wh ${chemistryLabel(s)}, ${acw}W AC${s.boost_mode_w ? ` (${s.boost_mode_w.toLocaleString()}W boost)` : ''}.`,
  runtimeLine,
  chargeText ? `0–80% in ${chargeText}.` : null,
  `${s.solar_input_w.toLocaleString()}W solar in.`,
  `Full spec table + ${APPLIANCES.length} appliance runtimes.`,
]);

const faq = [
  {
    q: `How long will the ${name} run a refrigerator?`,
    a: fridgeRt
      ? `About ${fridgeRt} on a full-size refrigerator. A fridge's compressor pulls around ${fullFridge.running_w}W while it runs but only runs about a third of the time, so the pack sees a 24-hour average of roughly ${fullFridge.average_w}W (at ~85% inverter efficiency). The ${s.ac_surge_w.toLocaleString()}W surge rating covers the ~${fullFridge.surge_w}W a compressor asks for at each restart. For your own fridge, divide the kWh/year on its EnergyGuide label by 8,760.`
      : `Probably not a full-size one. A fridge compressor asks for roughly ${fullFridge.surge_w}W for a second or two at every restart, above this unit's ${s.ac_surge_w.toLocaleString()}W surge rating, so it is likely to trip whatever its capacity.${miniRt ? ` It can run a mini fridge for about ${miniRt}.` : ''}`,
    link: { href: GUIDE_URLS.fridge, text: `Fridge runtimes for all ${all.length} models` },
  },
  ...(cpapNights
    ? [{
        q: `How many nights will the ${name} run a CPAP?`,
        a: `About ${cpapNights} nights from the AC outlet at ${cpapLoad('ac').watts}W with the humidifier off (${CPAP_HOURS_PER_NIGHT} hours a night), or ${cpapNightsDc} from the 12V DC outlet, which skips the inverter. A heated humidifier and tube push the draw to around ${cpapLoad('humid').watts}W${cpapNightsHumid ? ` and cut that to ${cpapNightsHumid} nights` : ''}.`,
        link: { href: GUIDE_URLS.cpap, text: `CPAP nights for all ${all.length} models` },
      }]
    : []),
  {
    q: `Does the ${name} use a LiFePO4 battery?`,
    a: s.chemistry === 'LFP'
      ? `Yes. It uses LiFePO4 (LFP) cells rated for about ${s.cycles_to_80pct.toLocaleString()} cycles to 80% capacity — roughly ${Math.round(s.cycles_to_80pct / 365)}+ years of daily cycling.`
      : `No. It uses NMC lithium-ion cells rated for about ${s.cycles_to_80pct.toLocaleString()} cycles to 80% capacity, which is a shorter service life than modern LiFePO4 models.`,
  },
  {
    q: `What solar panels work with the ${name}?`,
    a: `Any panel (or array) within its ${s.solar_voltage_range} MPPT voltage window and up to ${s.solar_input_w}W, connected via ${s.dc_input_connector}. Staying inside the voltage window matters more than matching wattage.`,
  },
  {
    q: `How fast does the ${name} recharge from a wall outlet?`,
    a: s.ac_charge_minutes_0_80
      ? `About ${s.ac_charge_minutes_0_80} minutes from 0 to 80% on AC power.`
      : `The manufacturer does not quote a standard 0–80% AC time for this model.`,
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      name,
      brand: { '@type': 'Brand', name: s.brand },
      description,
      url: new URL(Astro.url.pathname, Astro.site).href,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Power stations', item: new URL('/power-stations/', Astro.site).href },
        { '@type': 'ListItem', position: 2, name },
      ],
    },
  ],
};
---
<Base {title} {description} {schema}>
  <nav class="crumbs"><a href="/power-stations/">Power stations</a> › {name}</nav>
  <h1>{name}</h1>
  <p class="muted">{capacityClass(s.capacity_wh)} · Released {s.release_year} · Launch price ${s.msrp_usd.toLocaleString()}</p>

  <div class="kpis">
    <div class="kpi"><b>{s.capacity_wh.toLocaleString()} Wh</b> capacity</div>
    <div class="kpi"><b>{s.ac_output_w.toLocaleString()} W</b> AC output</div>
    <div class="kpi"><b>{s.chemistry}</b> {s.chemistry === 'LFP' ? 'LiFePO4' : 'lithium NMC'}</div>
    <div class="kpi"><b>${dollarsPerWh(s).toFixed(2)}</b> per Wh</div>
    <div class="kpi"><b>{whPerKg(s).toFixed(0)} Wh/kg</b> ({s.weight_kg} kg)</div>
  </div>

  {s.highlight && <div class="note"><b>Worth knowing:</b> {s.highlight}</div>}

  <h2>Full specifications</h2>
  <div class="tbl"><div class="tbl-scroll"><table>
    <tbody>
      <tr><th>Battery capacity</th><td>{s.capacity_wh.toLocaleString()} Wh</td></tr>
      <tr><th>Battery chemistry</th><td>{s.chemistry === 'LFP' ? 'LiFePO4 (LFP)' : 'Lithium NMC'} — {s.cycles_to_80pct.toLocaleString()} cycles to 80%</td></tr>
      <tr><th>AC output (continuous)</th><td>{s.ac_output_w.toLocaleString()} W{s.boost_mode_w ? ` (${s.boost_mode_w.toLocaleString()} W in boost mode)` : ''}</td></tr>
      <tr><th>AC output (surge)</th><td>{s.ac_surge_w.toLocaleString()} W</td></tr>
      <tr><th>AC outlets</th><td>{s.ac_outlets}</td></tr>
      <tr><th>Max USB-C power</th><td>{s.usb_c_max_w} W</td></tr>
      <tr><th>240V output</th><td>{s.output_240v ? 'Yes' : 'No'}</td></tr>
      <tr><th>Max solar input</th><td>{s.solar_input_w.toLocaleString()} W</td></tr>
      <tr><th>Solar voltage window (MPPT)</th><td>{s.solar_voltage_range}</td></tr>
      <tr><th>DC input connector</th><td>{s.dc_input_connector}</td></tr>
      {s.ac_charge_minutes_0_80 && <tr><th>AC recharge 0–80%</th><td>{s.ac_charge_minutes_0_80} min</td></tr>}
      <tr><th>UPS / EPS switchover</th><td>{s.ups_switchover_ms ? `${s.ups_switchover_ms} ms` : 'Not supported'}</td></tr>
      {s.expandable_max_wh && <tr><th>Expandable up to</th><td>{s.expandable_max_wh.toLocaleString()} Wh with extra batteries</td></tr>}
      <tr><th>Weight</th><td>{s.weight_kg} kg</td></tr>
    </tbody>
  </table></div></div>

  <h2>What can it run, and for how long?</h2>
  <p class="muted">Capacity × 85% inverter efficiency ÷ average draw. Fridges and freezers use their 24-hour average — the compressor only runs about a third of the time — and count only if this unit's surge rating can restart the compressor. Estimates from specifications, not bench measurements.</p>
  <div class="tbl"><div class="tbl-scroll"><table>
    <thead><tr><th>Appliance</th><th>Typical draw</th><th>Estimated runtime</th></tr></thead>
    <tbody>
      {APPLIANCES.map((a) => {
        const { hours, reason } = applianceRuntime(s, a);
        return (
          <tr>
            <td>{a.guide ? <a href={a.guide}>{a.name}</a> : a.name}</td>
            <td>{a.load ? <>{a.watts} W avg <span class="muted">· ~{a.load.surge_w.toLocaleString()} W to start</span></> : `${a.watts} W`}</td>
            <td>{hours !== null
              ? formatRuntime(hours)
              : reason === 'surge'
                ? <span class="muted">Can't start it ({s.ac_surge_w.toLocaleString()}W surge)</span>
                : <span class="muted">Exceeds {effectiveOutput(s).toLocaleString()}W output</span>}</td>
          </tr>
        );
      })}
    </tbody>
  </table></div></div>
  {cpapNights && <p>For CPAP users: that's roughly <b>{cpapNights} nights</b> of sleep (8h/night, humidifier off, AC outlet){cpapNightsDc && <>, or <b>{cpapNightsDc}</b> from the 12V DC outlet</>}.</p>}
  <p>Sizing for one appliance across all {all.length} models: <a href={GUIDE_URLS.cpap}>power station for a CPAP</a> · <a href={GUIDE_URLS.fridge}>power station for a refrigerator</a>.</p>

  <h2>Closest alternatives</h2>
  <div class="grid">
    {alts.map((alt) => (
      <div class="card">
        <a href={`/power-stations/${alt.slug}/`}>{fullName(alt)}</a>
        <p class="sub">{alt.capacity_wh.toLocaleString()}Wh · {alt.ac_output_w.toLocaleString()}W · {alt.chemistry} · ${alt.msrp_usd.toLocaleString()} launch</p>
      </div>
    ))}
  </div>

  {siblings.length > 0 && (
    <>
      <h2>Other {s.brand} models</h2>
      <div class="grid">
        {siblings.map((sb) => (
          <div class="card">
            <a href={`/power-stations/${sb.slug}/`}>{fullName(sb)} specs and runtimes</a>
            <p class="sub">{sb.capacity_wh.toLocaleString()}Wh · {sb.ac_output_w.toLocaleString()}W · {sb.chemistry}</p>
          </div>
        ))}
      </div>
    </>
  )}

  {comparisons.length > 0 && (
    <>
      <h2>Head-to-head comparisons</h2>
      <div class="grid">
        {comparisons.map((c) => (
          <div class="card">
            <a href={c.url}>{name} vs {fullName(c.other)} →</a>
          </div>
        ))}
      </div>
    </>
  )}

  <h2>FAQ</h2>
  {faq.map((f) => (
    <details class="faq">
      <summary>{f.q}</summary>
      <div>{f.a}{f.link && <> <a href={f.link.href}>{f.link.text} →</a></>}</div>
    </details>
  ))}

  <div class="disclosure">
    Specifications compiled from {s.brand}'s official documentation (<a href={s.brand_product_url} rel="nofollow noopener">source</a>). Spotted an error? We correct listings within 24 hours.
  </div>
</Base>
